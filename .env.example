# ─────────────────────────────────────────────────────────────
# PakRoam environment variables
# Copy this file to `.env.local` for local development.
# All secrets are read SERVER-SIDE only (never NEXT_PUBLIC).
# ─────────────────────────────────────────────────────────────

# ── eSIM Access provider API (https://esimaccess.com) ────────
# Get these from your eSIM Access reseller dashboard.
# When both are set the app runs in LIVE mode and provisions
# real eSIM profiles. When they are absent the app falls back
# to a simulated (mock) mode in local development only.
ESIM_ACCESS_ACCESS_CODE=
ESIM_ACCESS_SECRET_KEY=
# Optional override of the provider API root (defaults to
# https://backend.esimaccess.com/api/v1)
ESIM_ACCESS_BASE_URL=
# Explicitly allow mock provisioning when deployed without
# credentials (defaults to allowed in non-production builds).
ESIM_ACCESS_ALLOW_MOCK=false

# ── Payments (optional – simulated when unset) ───────────────
# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRATOR_ID=
# EasyPaisa
EASYPAISA_MERCHANT_ID=
EASYPAISA_SECURE_HASH=
# PayFast (local aggregator, also usable for cards)
PAYFAST_MERCHANT_ID=
PAYFAST_SECURE_HASH=
PAYFAST_MERCHANT_USERNAME=

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_WHATSAPP=923001234567
NEXT_PUBLIC_SUPPORT_EMAIL=support@pakroam.pk

# ── WhatsApp Agent API (powers /api/whatsapp) ────────────────
# Key used to authenticate with the WhatsApp Agent API.
WHATSAPP_AGENT_API_KEY=
# Optional: base URL of the agent API. When unset, outbound sends
# run in simulated mode in local development only.
WHATSAPP_AGENT_API_URL=
# Optional: webhook verify token + Meta app secret for
# X-Hub-Signature-256 validation (verify token defaults to the key).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Set true to explicitly allow simulated WhatsApp sending in prod.
WHATSAPP_ALLOW_MOCK=false

# ── Optional: dedicated secret for signing order URLs ────────
# Falls back to ESIM_ACCESS_SECRET_KEY when unset.
ORDER_SIGNING_SECRET=
